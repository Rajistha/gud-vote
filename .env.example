# Salin ke .env.local lalu isi.

# Pengembangan lokal: jalankan `npm run db:dev` (PGlite). Produksi: Supabase (Project Settings > Database > Connection string, mode pooler).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres
# Rahasia untuk menandatangani sesi admin. Buat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Email akun Supabase panitia yang menjadi panitia pertama (pisahkan dengan koma). Dipakai oleh `npm run db:seed`.
ADMIN_EMAILS=ketua@gmail.com

# Supabase Auth: akun panitia dibuat di Dashboard Supabase > Authentication > Users.
# Matikan pendaftaran publik: Authentication > Sign In / Providers > nonaktifkan "Allow new users to sign up".
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Opsional: agar panitia bisa membuat akun panitia dari halaman Panitia. Rahasia, jangan dibagikan.
SUPABASE_SERVICE_ROLE_KEY=

# Alamat situs yang ditampilkan di bagian "Cara memilih" (tanpa https://). Opsional.
NEXT_PUBLIC_SITE_HOST=gudvote.site

# Hanya untuk pengembangan: izinkan masuk admin tanpa Supabase. JANGAN diaktifkan di produksi.
DEV_ADMIN_LOGIN=1

# Opsional (disarankan di produksi): sertifikat CA Supabase (format PEM, satu baris dengan 
) agar identitas server database diverifikasi penuh.
# DATABASE_CA=

# Ukuran pool koneksi. Isi 1 untuk database lokal PGlite.
DB_POOL_MAX=5
